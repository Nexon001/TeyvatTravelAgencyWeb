@{
    bool IsActive(string controller, string action) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), action, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Teyvat Travel Co.</title>
    <meta name="description" content="@ViewData["Description"]">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body class="@ViewData["BodyClass"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="container nav-row">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <svg aria-hidden="true" fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="24" cy="24" r="21" stroke="#f8f3e4" stroke-width="2"></circle>
                    <path d="M24 10 L28 22 L24 38 L20 22 Z" fill="#a1791f"></path>
                    <circle cx="24" cy="24" fill="#f8f3e4" r="3"></circle>
                </svg>
                <span>Teyvat Travel Co.<span class="co">Journeys through the Seven Nations</span></span>
            </a>
            <button aria-expanded="false" aria-label="Toggle navigation" class="nav-toggle" type="button">
                <span></span>
            </button>
            @{
                bool onDestinations = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Destinations", StringComparison.OrdinalIgnoreCase);
            }
            <nav aria-label="Primary" class="site-nav">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" aria-current="@(IsActive("Home", "Index") ? "page" : null)">Home</a></li>
                    <li class="has-dropdown">
                        <a asp-controller="Destinations" asp-action="Index" aria-current="@(onDestinations ? "page" : null)">Destinations<span class="dropdown-caret">▾</span></a>
                        <ul class="dropdown">
                            <li><a asp-controller="Destinations" asp-action="Mondstadt" aria-current="@(IsActive("Destinations", "Mondstadt") ? "page" : null)">Mondstadt</a></li>
                            <li><a asp-controller="Destinations" asp-action="Liyue" aria-current="@(IsActive("Destinations", "Liyue") ? "page" : null)">Liyue</a></li>
                            <li><a asp-controller="Destinations" asp-action="Inazuma" aria-current="@(IsActive("Destinations", "Inazuma") ? "page" : null)">Inazuma</a></li>
                            <li><a asp-controller="Destinations" asp-action="Sumeru" aria-current="@(IsActive("Destinations", "Sumeru") ? "page" : null)">Sumeru</a></li>
                            <li><a asp-controller="Destinations" asp-action="Fontaine" aria-current="@(IsActive("Destinations", "Fontaine") ? "page" : null)">Fontaine</a></li>
                            <li><a asp-controller="Destinations" asp-action="Natlan" aria-current="@(IsActive("Destinations", "Natlan") ? "page" : null)">Natlan</a></li>
                            <li><a asp-controller="Destinations" asp-action="Snezhnaya" aria-current="@(IsActive("Destinations", "Snezhnaya") ? "page" : null)">Snezhnaya</a></li>
                        </ul>
                    </li>
                    <li><a asp-controller="Home" asp-action="Profile" aria-current="@(IsActive("Home", "Profile") ? "page" : null)">Company Profile</a></li>
                </ul>
            </nav>
        </div>
    </header>
    <main id="main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <h4>Teyvat Travel Co.</h4>
                <p style="max-width:34ch; color:var(--ink-soft); font-size:.92rem;">Independent, itinerary-first travel planning across all seven nations — one desk, one director, one dossier per traveller.</p>
            </div>
            <div>
                <h4>Destinations</h4>
                <ul>
                    <li><a asp-controller="Destinations" asp-action="Index">View all destinations</a></li>
                    <li><a asp-controller="Destinations" asp-action="Mondstadt">Mondstadt</a></li>
                    <li><a asp-controller="Destinations" asp-action="Liyue">Liyue</a></li>
                    <li><a asp-controller="Destinations" asp-action="Inazuma">Inazuma</a></li>
                    <li><a asp-controller="Destinations" asp-action="Sumeru">Sumeru</a></li>
                    <li><a asp-controller="Destinations" asp-action="Fontaine">Fontaine</a></li>
                    <li><a asp-controller="Destinations" asp-action="Natlan">Natlan</a></li>
                    <li><a asp-controller="Destinations" asp-action="Snezhnaya">Snezhnaya</a></li>
                </ul>
            </div>
            <div>
                <h4>Agency</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Profile">Company profile</a></li>
                    <li><a asp-controller="Home" asp-action="Profile" asp-fragment="director">About the Director</a></li>
                    <li><a href="mailto:desk@teyvattravel.co">desk@teyvattravel.co</a></li>
                </ul>
            </div>
        </div>
        <div class="container footer-bottom">
            <span>© 2026 Teyvat Travel Co. All rights reserved.</span>
            <span>Sole proprietorship · est. Mondstadt</span>
        </div>
    </footer>
    <script>
            (function() {
                var toggle = document.querySelector('.nav-toggle');
                var nav = document.querySelector('.site-nav');
                if (!toggle || !nav) return;

                function setOpen(open) {
                    nav.classList.toggle('is-open', open);
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
                    document.body.classList.toggle('nav-open', open);
                }

                toggle.addEventListener('click', function() {
                    setOpen(!nav.classList.contains('is-open'));
                });

                // close after tapping any link in the menu
                nav.addEventListener('click', function(e) {
                    if (e.target.closest('a')) setOpen(false);
                });

                // close on Escape or when tapping outside the header
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') setOpen(false);
                });
                document.addEventListener('click', function(e) {
                    if (nav.classList.contains('is-open') && !e.target.closest('.site-header')) setOpen(false);
                });

                // reset if the window is resized up to desktop width
                window.matchMedia('(min-width: 861px)').addEventListener('change', function(m) {
                    if (m.matches) setOpen(false);
                });
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
