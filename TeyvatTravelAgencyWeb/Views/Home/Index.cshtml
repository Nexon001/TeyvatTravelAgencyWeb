@{
    ViewData["Title"] = "Your Next Journey Awaits in Teyvat";
    ViewData["Description"] = "Teyvat Travel Co. crafts custom itineraries across all seven nations of Teyvat — Mondstadt, Liyue, Inazuma, Sumeru, Fontaine, Natlan and Snezhnaya.";
    ViewData["BodyClass"] = "chapter-profile";
}
<section class="landing-hero" style="background-image:url('@Url.Content("~/images/nations/mondstadt-hero.jpg")');">
<div class="container landing-hero-inner">
<p class="landing-eyebrow">EXPLORE &middot; DISCOVER &middot; BELONG</p>
<h1>Your Next Journey Awaits in Teyvat</h1>
<p>From the wind-swept heights of Mondstadt to the storm-lit shores of Inazuma, experience the seven nations like never before. We craft unforgettable itineraries, tailored to your journey.</p>
<div class="landing-hero-ctas">
<a class="btn btn-brass" asp-controller="Destinations" asp-action="Index">Explore Destinations &rarr;</a>
<a class="btn btn-outline-light" asp-controller="Home" asp-action="Profile">About Us</a>
</div>
</div>
</section>

<section class="home-stats">
<div class="container home-stats-inner">
<dl class="home-stats-grid">
<div class="stat">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6z"/></svg>
<div><dt>7 Nations</dt><dd>One incredible world</dd></div>
</div>
<div class="stat">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 19l6-10 4 6 3-4 5 8"/><circle cx="9" cy="9" r="1.4"/></svg>
<div><dt>Custom Itineraries</dt><dd>Built around your journey</dd></div>
</div>
<div class="stat">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9.5 12l1.8 1.8L14.5 10"/></svg>
<div><dt>Trusted &amp; Safe</dt><dd>Every route personally reviewed</dd></div>
</div>
<div class="stat">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 13a8 8 0 0116 0"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/></svg>
<div><dt>Always Reachable</dt><dd>One desk, real answers</dd></div>
</div>
</dl>
<p class="home-quote">&ldquo;Not just a trip, but a story worth telling.&rdquo;</p>
</div>
</section>

<section class="content">
<div class="container">
<div class="section-head-row">
<div>
<h2 style="margin-bottom:.2em;">Discover the Seven Nations</h2>
<p style="margin:0; color:var(--ink-soft); font-size:.95rem;">A first look at four of the seven — every one of them gets its own full chapter.</p>
</div>
<a asp-controller="Destinations" asp-action="Index">View all destinations &rarr;</a>
</div>
<div class="dest-grid">
<a class="dest-tile" asp-controller="Destinations" asp-action="Mondstadt">
<img src="~/images/nations/mondstadt-hero.jpg" alt="Mondstadt — vineyard hills and clifftop windmills" asp-append-version="true">
<div class="dest-tile-label">
<div><h3>Mondstadt</h3><p>Freedom, wine, and wide skies.</p></div>
<span class="dest-tile-arrow" aria-hidden="true">→</span>
</div>
</a>
<a class="dest-tile" asp-controller="Destinations" asp-action="Liyue">
<img src="~/images/nations/liyue-hero.jpg" alt="Liyue — a terraced harbour beneath jade-toned peaks" asp-append-version="true">
<div class="dest-tile-label">
<div><h3>Liyue</h3><p>Prosperity in every step.</p></div>
<span class="dest-tile-arrow" aria-hidden="true">→</span>
</div>
</a>
<a class="dest-tile" asp-controller="Destinations" asp-action="Sumeru">
<img src="~/images/nations/sumeru-hero.jpg" alt="Sumeru — rainforest canopy meeting open desert" asp-append-version="true">
<div class="dest-tile-label">
<div><h3>Sumeru</h3><p>Knowledge shapes the future.</p></div>
<span class="dest-tile-arrow" aria-hidden="true">→</span>
</div>
</a>
<a class="dest-tile" asp-controller="Destinations" asp-action="Snezhnaya">
<img src="~/images/nations/snezhnaya-hero.jpg" alt="Snezhnaya — aurora-lit tundra and frost peaks" asp-append-version="true">
<div class="dest-tile-label">
<div><h3>Snezhnaya</h3><p>Where the cold tells a story.</p></div>
<span class="dest-tile-arrow" aria-hidden="true">→</span>
</div>
</a>
</div>
</div>
</section>

<section class="content" style="padding-top:8px;">
<div class="container why-section">
<div>
<h2 style="margin-bottom:.15em;">Why Travel With Us</h2>
<p style="color:var(--ink-soft); font-size:.95rem; margin-bottom:0;">More than a travel agency — we're your companions in exploration.</p>
<div class="why-list">
<div class="why-item">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6z"/></svg>
<h3>Expert Guides</h3>
<p>Local knowledge, real experience.</p>
</div>
<div class="why-item">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/></svg>
<h3>Flexible Packages</h3>
<p>From quick getaways to full expeditions.</p>
</div>
<div class="why-item">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L12 17l-5.6 3.1 1.4-6.3-4.8-4.3 6.4-.6z"/></svg>
<h3>Exclusive Access</h3>
<p>Hidden spots, special experiences.</p>
</div>
<div class="why-item">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 20s-7-4.3-9.3-8.6C1.2 8 3 5 6.3 5c2 0 3.4 1.1 5.7 3.4C14.3 6.1 15.7 5 17.7 5 21 5 22.8 8 21.3 11.4 19 15.7 12 20 12 20z"/></svg>
<h3>Traveler Support</h3>
<p>Before, during, and after your trip.</p>
</div>
</div>
</div>
<div class="why-cta-card" style="background-image:url('@Url.Content("~/images/nations/fontaine-hero.jpg")');">
<div class="why-cta-card-inner">
<p class="eyebrow">READY TO EXPLORE?</p>
<h3>Plan Your Journey Today</h3>
<a class="btn btn-brass" href="mailto:desk@teyvattravel.co">Get Started &rarr;</a>
</div>
</div>
</div>
</section>
